---
import { Image } from 'astro:assets';
import foto from '../assets/centro/tratamiento-espalda.jpg';
import { centro, telUrl } from '../data/centro';
---
<section aria-labelledby="hero-t" class="relative overflow-hidden">
  <div class="mx-auto grid max-w-[90rem] items-center gap-10 px-4 pb-16 pt-10 sm:px-8 lg:grid-cols-12 lg:pb-24 lg:pt-16">
    <div class="relative z-10 lg:col-span-6">
      <p class="label flex items-center gap-3 text-verd" data-reveal><span class="h-0.5 w-8 bg-vermell" aria-hidden="true"></span>Centro médico · Fisioterapia · Osteopatía</p>
      <h1 id="hero-t" class="display mt-6 text-[clamp(4rem,10.5vw,9.5rem)]" data-reveal style="--i:1">
        De la lesión<br /><span class="text-vermell">a la pista.</span>
      </h1>
      <p class="mt-7 max-w-lg text-xl text-ink-2" data-reveal style="--i:2">
        Rehabilitación deportiva en el {centro.street.replace(',', '')} de Sant Feliu. Fisioterapeutas, osteópatas y médicos en el mismo centro, y más de 20 mutuas.
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--i:3">
        <a href={centro.whatsapp} target="_blank" rel="noopener" class="btn btn-vermell">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
          Pide cita por WhatsApp
        </a>
        <a href={telUrl} class="btn btn-line tabular-nums">{centro.phone.display}</a>
      </div>
    </div>

    <div class="relative lg:col-span-6">
      <div class="absolute -right-24 top-10 hidden h-[85%] w-[70%] bg-verd lg:block" aria-hidden="true"></div>
      <div class="absolute -bottom-4 left-6 h-24 w-24 bg-vermell sm:h-32 sm:w-32" aria-hidden="true"></div>
      <figure class="relative" data-reveal style="--i:2">
        <Image src={foto} alt="Un fisioterapeuta de Amicitia, con la camiseta del centro, trata la espalda de una paciente en la camilla" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 45vw, 92vw" class="aspect-[4/5] w-full object-cover object-[50%_30%] sm:aspect-[5/5]" loading="eager" fetchpriority="high" />
        <figcaption class="label absolute bottom-0 right-0 bg-ink px-4 py-3 text-[0.72rem] text-white">Passeig dels Pins, 47</figcaption>
      </figure>
    </div>
  </div>
</section>
