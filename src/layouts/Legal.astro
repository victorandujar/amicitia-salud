---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<Base title={`${title} · Amicitia Salud`} description={`${title} de Amicitia Salud.`}>
  <Header />
  <main id="contenido" class="mx-auto max-w-3xl px-4 py-20 sm:px-8 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_p]:mt-4 [&_p]:text-ink-2">
    <h1 class="display text-6xl">{title}</h1>
    <p class="mt-6 bg-white p-4 text-sm">Texto provisional de la propuesta. Los datos marcados como <mark>pendiente</mark> los debe facilitar el centro antes de publicar la web.</p>
    <slot />
  </main>
  <Footer />
</Base>
