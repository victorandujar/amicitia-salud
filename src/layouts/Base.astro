---
import '../styles/global.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import display from '@fontsource/barlow-condensed/files/barlow-condensed-latin-800-normal.woff2?url';
import body from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import Seo from '../components/Seo.astro';
import { isDemo } from '../lib/site';
import { centro } from '../data/centro';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={body} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:bg-ink focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
    {isDemo && (
      <aside aria-label="Aviso de propuesta" class="relative z-50 bg-ink text-white/80">
        <p class="label mx-auto max-w-[90rem] px-4 py-2 text-center text-[0.72rem]">Propuesta de diseño no oficial<span class="hidden sm:inline"> · Preparada por Web Local Growth para {centro.name}</span></p>
      </aside>
    )}
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
